[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[user]
	signingkey = ssh-rsa 
	name = xutiancheng
	email = tiancheng.xu@yo-star.com
[core]
	editor = code --wait
	autocrlf = input
	excludesfile = /Users/xutiancheng/.config/git/ignore
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = zebra
	tool = delta
[rebase]
	autoStash = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Sublime Snazzy
[merge]
	conflictstyle = zdiff3
[log]
	date = iso
[alias]
	l = log --oneline --graph --decorate
	s = status -s
	d = diff
	ds = diff --staged
	co = checkout
	br = branch
	undo = reset HEAD~1 --mixed
	la = log --oneline --graph --decorate --all
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[maintenance]
	auto = true
	strategy = incremental
