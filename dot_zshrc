# 逐个更新已安装插件（包含延迟加载项），保留 Zinit 的 hooks，不自动删除插件。
function zinit-update() {
  emulate -L zsh
  setopt extended_glob
  (( $# == 0 )) || { print -u2 -r -- 'usage: zinit-update'; return 2; }
  if (( ! $+functions[zinit] || ! $+commands[git] )); then
    print -u2 -r -- 'zinit-update: zinit or git is unavailable'
    return 1
  fi
  local plugin_dir=${ZINIT[PLUGINS_DIR]:-} repo plugin guard_dir git_bin rc
  local -a plugins failed
  [[ -d $plugin_dir ]] || { print -u2 -r -- 'zinit-update: plugin directory is unavailable'; return 1; }
  for repo in "$plugin_dir"/*(N/); do
    [[ ${repo:t} == (custom|_local---zinit) ]] && continue
    [[ -e $repo/.git || -f $repo/._zinit/is_release ]] || continue
    plugin=${repo:t}
    plugins+=("${plugin//---//}")
  done
  git_bin=${_ZINIT_UPDATE_REAL_GIT:-${commands[git]:A}}
  guard_dir=$(command mktemp -d "${TMPDIR:-/tmp}/zinit-update.XXXXXXXX") || return 1
  {
    # Zinit 上游会吞掉部分 fetch/pull 的状态；仅记录操作名和退出码，不记录参数。
    /bin/cat > "$guard_dir/git" <<'SH'
#!/bin/sh
op= skip=0
for arg do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$arg" in
    -C|-c|--git-dir|--work-tree|--namespace|--config-env) skip=1 ;;
    -*) ;;
    *) op=$arg; break ;;
  esac
done
"$_ZINIT_UPDATE_REAL_GIT" "$@"
rc=$?
case "$op" in
  fetch|pull|clone|submodule)
    if [ "$rc" -ne 0 ]; then
      printf '%s:%s\n' "$op" "$rc" >> "$_ZINIT_UPDATE_GIT_FAILURES"
    fi ;;
esac
exit "$rc"
SH
    (( $? == 0 )) || return 1
    command chmod 700 "$guard_dir/git" || return 1
    local -x _ZINIT_UPDATE_REAL_GIT=$git_bin
    local -x _ZINIT_UPDATE_GIT_FAILURES="$guard_dir/failures"
    local PATH="$guard_dir:$PATH"
    rehash
    # 空项代表仅执行一次 self-update；单插件 update 不会再次 self-update。
    for plugin in '' "${plugins[@]}"; do
      : > "$_ZINIT_UPDATE_GIT_FAILURES" || return 1
      print -r -- "── zinit: ${plugin:-self}"
      if [[ -z $plugin ]]; then
        zinit self-update --quiet
      else
        zinit update --quiet "$plugin"
      fi
      rc=$?
      if (( rc != 0 )) || [[ -s $_ZINIT_UPDATE_GIT_FAILURES ]]; then
        failed+=("${plugin:-self}")
        print -u2 -r -- "zinit-update failed: ${plugin:-self} (zinit exit $rc)"
        [[ -s $_ZINIT_UPDATE_GIT_FAILURES ]] && /bin/cat "$_ZINIT_UPDATE_GIT_FAILURES" >&2
      fi
    done
    zinit compinit || failed+=(compinit)
    if (( ${#failed} )); then
      print -u2 -r -- "zinit-update failures: ${(j:, :)failed}"
      return 1
    fi
    return 0
  } always {
    command rm -rf -- "$guard_dir"
    rehash
  }
}

# 更新 brew 及所有已安装的包和 cask，完成后清理旧版本
function brew-update() {
  brew update --quiet || return $?
  brew upgrade --force --quiet || return $?
  brew cleanup --prune=all --quiet || return $?
  brew autoremove --quiet || return $?
  mas upgrade
}

# 更新 Homebrew、Zinit 及独立 CLI；-n/--dry-run 只预览，不执行更新。
function update-all() {
  emulate -L zsh
  local dry_run=0 gopls_bin codegraph_bin
  local -a failed
  if (( $# > 1 )); then
    print -u2 -r -- 'usage: update-all [-n|--dry-run]'
    return 2
  fi
  case "${1:-}" in
    '') ;;
    -n|--dry-run) dry_run=1 ;;
    -h|--help)
      print -r -- 'usage: update-all [-n|--dry-run]'
      print -r -- 'Updates Homebrew, Zinit, Codegraph, gopls and Rust toolchains; regenerates ~/.config/Brewfile.'
      return 0 ;;
    *) print -u2 -r -- 'usage: update-all [-n|--dry-run]'; return 2 ;;
  esac
  _ua_step() {
    local label=$1 t=$SECONDS rc; shift
    print -P "%F{cyan}── $label %f"
    if (( dry_run )); then
      print -r -- "would run: ${(j: :)${(q)@}}"
      return 0
    fi
    "$@"
    rc=$?
    if (( rc == 0 )); then
      print -P "%F{245}↳ ⏱ $((SECONDS-t))s%f"
    else
      print -P "%F{red}✗ $label failed ($((SECONDS-t))s, exit $rc)%f"
    fi
    return $rc
  }
  {
    _ua_step "brew" brew-update || failed+=("brew")
    _ua_step "zinit" zinit-update || failed+=("zinit")
    codegraph_bin=${commands[codegraph]:-}
    [[ -x "$HOME/.local/bin/codegraph" ]] && codegraph_bin="$HOME/.local/bin/codegraph"
    if [[ -n $codegraph_bin ]]; then
      _ua_step "codegraph" "$codegraph_bin" upgrade || failed+=("codegraph")
    else
      print -r -- 'skip codegraph: not installed'
    fi
    if (( $+commands[go] && $+commands[gopls] )); then
      gopls_bin=${commands[gopls]:A}
      if [[ $gopls_bin == */Cellar/* || $gopls_bin == */Caskroom/* ]]; then
        print -r -- 'skip gopls: managed by Homebrew'
      else
        _ua_step "gopls" env "GOBIN=${gopls_bin:h}" go install golang.org/x/tools/gopls@latest || failed+=("gopls")
      fi
    else
      print -r -- 'skip gopls: go or gopls not installed'
    fi
    if (( $+commands[rustup] )); then
      # rustup 本身由 Homebrew 管理，只更新已安装的工具链。
      _ua_step "rust toolchains" rustup update --no-self-update || failed+=("rust toolchains")
    else
      print -r -- 'skip rust toolchains: rustup not installed'
    fi
    _ua_step "Brewfile" brew bundle dump --file="$HOME/.config/Brewfile" --force --quiet || failed+=("Brewfile")
  } always {
    unfunction _ua_step
  }
  if (( ${#failed} )); then
    print -P "%F{red}── failed: ${(j:, :)failed}%f"
    return 1
  fi
  if (( dry_run )); then
    print -P "%F{green}── preview complete (no changes)%f"
  else
    print -P "%F{green}── done%f"
  fi
}

# chezmoi-push [-n|--dry-run] [-a|--all] [file ...]
# -n 只预览；-a 同步已管理的文件和链接，跳过模板。
# 无参数提交源目录修改并推送；工作树干净时也可重试上次失败的推送。
function chezmoi-push() {
  emulate -L zsh
  local chezmoi_src dry_run=0 all_files=0 abs src managed entry git_status msg rc
  local -aU targets
  local -a normalized re_added names
  local -A managed_paths target_ops

  while (( $# )); do
    case "$1" in
      -n|--dry-run) dry_run=1 ;;
      -a|--all) all_files=1 ;;
      --) shift; targets+=("$@"); break ;;
      -*) print -u2 -r -- "unknown option: $1"; return 2 ;;
      *) targets+=("$1") ;;
    esac
    shift
  done
  for abs in "${targets[@]}"; do
    [[ -n $abs ]] || { print -u2 -r -- "empty target path"; return 2; }
  done

  chezmoi_src=$(chezmoi source-path) || return $?
  [[ -n $chezmoi_src && -d $chezmoi_src ]] || {
    print -u2 -r -- "invalid chezmoi source directory: $chezmoi_src"
    return 1
  }
  # 先验证源仓库，避免同步目标后才发现 Git 不可用。
  GIT_OPTIONAL_LOCKS=0 git -C "$chezmoi_src" rev-parse --git-dir >/dev/null || return $?

  if (( all_files )); then
    managed=$(chezmoi managed --include=files,symlinks --path-style=absolute --nul-path-separator) || return $?
    targets+=("${(@0)managed}")
    targets=("${(@)targets:#}")
  fi
  if (( ${#targets} )); then
    managed=$(chezmoi managed --path-style=absolute --nul-path-separator) || return $?
    for entry in "${(@0)managed}"; do
      [[ -n $entry ]] && managed_paths[${entry:a}]=1
    done
  fi

  # :a 只规范化绝对路径，保留符号链接自身；:A 会错误地跟随链接。
  for abs in "${targets[@]}"; do
    abs=${abs:a}
    [[ -f $abs || -d $abs || -L $abs ]] || {
      print -u2 -r -- "missing or unsupported target: $abs"
      return 1
    }
    normalized+=("$abs")
    if [[ -n ${managed_paths[$abs]-} ]]; then
      src=$(chezmoi source-path -- "$abs") || return $?
      [[ -n $src ]] || {
        print -u2 -r -- "empty source path for managed target: $abs"
        return 1
      }
      # 模板只能直接编辑；re-add 递归目录时也会由 chezmoi 保留模板。
      if [[ $src == *.tmpl ]]; then
        target_ops[$abs]=skip
        print -r -- "skip template: $abs (edit $src)"
      elif [[ -L $abs ]]; then
        # re-add 会忽略符号链接；add 才能更新链接目标。
        target_ops[$abs]=add
      else
        target_ops[$abs]=re-add
      fi
    else
      target_ops[$abs]=add
    fi
  done
  targets=("${normalized[@]}")

  # 所有目标预检通过后才写入，dry-run 完全不调用 add/re-add。
  for abs in "${targets[@]}"; do
    [[ ${target_ops[$abs]} == skip ]] && continue
    if (( dry_run )); then
      print -r -- "would ${target_ops[$abs]}: $abs"
      continue
    fi
    chezmoi "${target_ops[$abs]}" -- "$abs"
    rc=$?
    if (( rc )); then
      print -u2 -r -- "${target_ops[$abs]} failed: $abs"
      return $rc
    fi
    re_added+=("$abs")
  done

  git_status=$(GIT_OPTIONAL_LOCKS=0 git -C "$chezmoi_src" status --short) || return $?
  if [[ -n $git_status ]]; then
    print -r -- "$git_status"
    # 分开展示暂存和未暂存修改，也兼容还没有 HEAD 的新仓库。
    GIT_OPTIONAL_LOCKS=0 git -C "$chezmoi_src" diff --stat || return $?
    GIT_OPTIONAL_LOCKS=0 git -C "$chezmoi_src" diff --cached --stat || return $?
    if (( dry_run )); then
      print -r -- "would stage and commit changes"
    else
      if (( ${#re_added} )); then
        names=("${(@)re_added:t}")
        msg="chore: update ${(j:, :)names}"
      else
        msg="chore: update dotfiles"
      fi
      git -C "$chezmoi_src" add -A || return $?
      git -C "$chezmoi_src" commit -m "$msg" || return $?
    fi
  else
    print -r -- "nothing to commit"
  fi

  # 上次提交可能已成功而推送失败；干净工作树也必须允许重新推送。
  # 由 Git 使用已配置的 remote/upstream，不猜目标，也不自动改 tracking。
  if (( dry_run )); then
    print -r -- "would run git push using the configured remote/upstream"
    return 0
  fi
  git -C "$chezmoi_src" push
}

