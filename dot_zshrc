# 与 Atuin 的 history_filter 保持一致。
# 逐行检查，避免多行命令绕过敏感内容过滤。
function _zsh_filter_sensitive_history() {
  emulate -L zsh
  setopt extendedglob

  local entry=$1 line
  # 保留前导空格/Tab 不记入历史的约定。
  [[ $entry == [[:blank:]]* ]] && return 1

  for line in "${(@f)entry}"; do
    line=${line##[[:blank:]]#}
    case $line in
      (export\ *\=*|EDITOR\=*|*_KEY\=*|*_SECRET\=*|*_TOKEN\=*|*_PASSWORD\=*|op\ read\ *|op\ run\ *)
        return 1
        ;;
    esac
  done
  return 0
}

autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _zsh_filter_sensitive_history

