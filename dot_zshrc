# 历史记录
HISTFILE="$XDG_STATE_HOME/zsh/history"  # 必须在 .zshrc 设置，否则 /etc/zshrc 会覆盖
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE SHARE_HISTORY HIST_REDUCE_BLANKS HIST_VERIFY

# Emacs 行编辑模式（zsh 默认 main=viins，Ctrl+A/E/K 等失效，显式切回 emacs）
bindkey -e

# 跳词/删词边界：去掉 / = . 让路径分隔符成为词边界
WORDCHARS='*?_-[]~&;!#$%^(){}<>'

# zsh 行为优化
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT EXTENDED_GLOB NO_BEEP INTERACTIVE_COMMENTS NO_CASE_GLOB NUMERIC_GLOB_SORT COMPLETE_IN_WORD ALWAYS_TO_END GLOB_DOTS
unsetopt CORRECT

# Zinit — 插件管理器，未安装时自动克隆
ZINIT_HOME="$HOME/.local/share/zinit/zinit.git"
typeset -A ZINIT
ZINIT[ZCOMPDUMP_PATH]="$XDG_CACHE_HOME/zsh/zcompdump"  # 必须在 source zinit.zsh 之前设置
if [[ ! -f "$ZINIT_HOME/zinit.zsh" ]]; then
    print -P "%F{33}正在安装 Zinit…%f"
    command mkdir -p "$(dirname $ZINIT_HOME)"
    command git clone https://github.com/zdharma-continuum/zinit "$ZINIT_HOME" && \
        print -P "%F{34}安装成功%f" || \
        print -P "%F{160}安装失败%f"
fi

source "$ZINIT_HOME/zinit.zsh"

ZSH_AUTOSUGGEST_STRATEGY=(atuin completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(history-substring-search-up history-substring-search-down accept-line zle-line-init)

HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
HISTORY_SUBSTRING_SEARCH_FUZZY=1
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='fg=black,bg=green,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=white,bg=red,bold'

# fzf-tab 必须立即加载（需在 compinit 之后、提示符之前）
zinit light Aloxaf/fzf-tab

# 其余插件全部懒加载：blockf 让 zinit 接管补全注册，zicompinit 替代手动 compinit
zinit wait lucid light-mode for \
  blockf \
      zsh-users/zsh-completions \
  atinit'zicompinit; zicdreplay' \
      zdharma-continuum/fast-syntax-highlighting \
  atload'bindkey "^[[A" history-substring-search-up; bindkey "^[[B" history-substring-search-down' \
      zsh-users/zsh-history-substring-search \
  atload'_zsh_autosuggest_start' \
      zsh-users/zsh-autosuggestions \
      hlissner/zsh-autopair

# fzf — 模糊搜索
eval "$(/opt/homebrew/bin/fzf --zsh)"

# Ctrl+Delete 删词
bindkey '^[[3;5~' kill-word

# Ctrl+Y 复制最近一条匹配的历史命令到剪贴板（通过 atuin + fzf）
function _atuin_copy() {
  local cmd
  cmd=$(atuin search --cmd-only --limit 5000 2>/dev/null | fzf --no-multi --reverse --height=40% \
    --header='Ctrl+Y — 选中后复制到剪贴板' \
    --bind='enter:execute-silent(echo -n {} | pbcopy)+abort')
  zle reset-prompt
}
zle -N _atuin_copy
bindkey '^Y' _atuin_copy
# Ctrl+Z 后台挂起（zle -N 注册避免 FSH unhandled widget 警告）
zle -N suspend
bindkey '^Z' suspend
# ESC ESC 在行首加 sudo
autoload -Uz sudo
zle -N sudo-command-line
bindkey '^[^[' sudo-command-line

# 补全缓存
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

# 补全匹配：先精确匹配，再大小写不敏感，再部分词匹配
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# 启用补全分组，fzf-tab 的 < > 切换分组依赖此设置
zstyle ':completion:*' group-name ''
# 补全分组标题（不加装饰符，避免空分组渲染成横线）
zstyle ':completion:*:descriptions' format '[%d]'
# 无匹配时提示
zstyle ':completion:*:warnings' format '── no matches ──'
# 禁用原生菜单，让 fzf-tab 完全接管
zstyle ':completion:*' menu no
# 文件名着色（LS_COLORS 在 .zshenv 已 export，此处展开）
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# fzf-tab — Tab 补全预览
zstyle ':fzf-tab:*' use-fzf-default-opts yes   # 继承 FZF_DEFAULT_OPTS（颜色主题、绑定等）
zstyle ':fzf-tab:*' prefix '◆ '              # 分组颜色指示符（双空格补偿双宽字符）
zstyle ':fzf-tab:*' fzf-min-height 10          # 动态高度下限，不固定覆盖
zstyle ':fzf-tab:*' fzf-flags '--border=rounded' '--color=header:italic:bold' '--preview-window=right:55%:wrap'
zstyle ':fzf-tab:*' active-group-style bold underline  # 当前选中分组的标题样式
zstyle ':fzf-tab:*' switch-group '<' '>'       # < > 切换补全分组
zstyle ':fzf-tab:*' show-group brief           # 只在切换时显示 header，平时不占行
zstyle ':fzf-tab:*' continuous-trigger '/'     # 路径补全连续触发

# 目录预览（cd / zoxide / pushd）
zstyle ':fzf-tab:complete:(cd|pushd|__zoxide_z):*' fzf-preview 'eza --icons --tree --level=2 --color=always $word'

# 文件预览（通用：目录 / 文本 / 其他类型）
_fzf_tab_file_preview='
  if [[ -d $realpath ]]; then
    eza --icons --tree --level=2 --color=always $realpath
  elif [[ -f $realpath ]]; then
    bat --color=always --style=numbers --line-range=:150 $realpath 2>/dev/null || file --brief $realpath
  fi
'
zstyle ':fzf-tab:complete:(bat|vim|nvim|code|cat|less|diff|cp|mv|rm|open):*' \
  fzf-preview "$_fzf_tab_file_preview"
unset _fzf_tab_file_preview

# kill — 进程预览（macOS ps 语法：-p 不用 --pid）
zstyle ':fzf-tab:complete:(kill|pkill):argument-rest' fzf-preview \
  '[[ $group == "[process ID]" ]] && ps -p $word -o pid,ppid,user,%cpu,%mem,command 2>/dev/null | tail -n +2'
zstyle ':fzf-tab:complete:(kill|pkill):argument-rest' fzf-flags '--preview-window=down:3:wrap'

# env/export — 变量值预览
zstyle ':fzf-tab:complete:(export|unset|printenv):*' fzf-preview 'echo ${(P)word}'

# git — 分支/文件预览
zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview \
  'git diff --color=always -- $word 2>/dev/null | head -200'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview \
  'case $group in
    "modified file")        git diff --color=always -- $word | head -200 ;;
    "recent commit object name") git show --color=always $word | head -80 ;;
    *)                      git log --oneline --color=always $word 2>/dev/null | head -30 ;;
  esac'

# man — 手册预览
zstyle ':fzf-tab:complete:man:*' fzf-preview 'man $word 2>/dev/null | col -bx | head -80'

# ssh — 主机配置预览
zstyle ':fzf-tab:complete:ssh:*' fzf-preview \
  'cat ~/.ssh/config 2>/dev/null | grep -A5 "Host $word" | head -10 || echo $word'

# brew — 包信息预览
zstyle ':fzf-tab:complete:brew-(install|uninstall|search|info):*' \
  fzf-preview 'brew info $word 2>/dev/null'

# git log — 提交历史预览
zstyle ':fzf-tab:complete:git-log:*' fzf-preview \
  'git log --oneline --graph --color=always $word 2>/dev/null | head -50'

# docker — 容器/镜像信息预览
zstyle ':fzf-tab:complete:docker-(run|exec|stop|rm|rmi|pull):*' fzf-preview \
  'docker inspect $word 2>/dev/null | jq ".[0] | {Name, Status: .State.Status, Image: .Config.Image}" 2>/dev/null || echo $word'

# go — 文档预览
zstyle ':fzf-tab:complete:go:*' fzf-preview \
  'go doc $word 2>/dev/null | head -30'

# 更新 zinit 自身及所有已安装插件，并删除 .zshrc 中不再引用的插件
function zinit-update() {
  zinit self-update --quiet
  zinit update --all --parallel --quiet
  zinit delete --clean --quiet --yes
}

# 更新 brew 及所有已安装的包和 cask，完成后清理旧版本
function brew-update() {
  brew update --quiet
  brew upgrade --force --quiet
  brew cleanup --prune=all --quiet
  brew autoremove --quiet
  mas upgrade
}

# 解压任意格式文件
function extract() {
  if [[ ! -f "$1" ]]; then
    gum style --foreground 1 "文件不存在: $1"
    return 1
  fi
  case "$1" in
    *.tar.bz2)  tar xjf "$1"     ;;
    *.tar.gz)   tar xzf "$1"     ;;
    *.tar.xz)   tar xJf "$1"     ;;
    *.tar.zst)  tar --zstd -xf "$1" ;;
    *.tar)      tar xf "$1"      ;;
    *.bz2)      bunzip2 "$1"     ;;
    *.gz)       gunzip "$1"      ;;
    *.zip)      unzip "$1"       ;;
    *.7z)       7z x "$1"        ;;
    *.rar)      unrar x "$1"     ;;
    *.xz)       unxz "$1"        ;;
    *.zst)      unzstd "$1"      ;;
    *)
      gum style --foreground 1 "不支持的格式: $1"
      return 1
      ;;
  esac
  gum style --foreground 2 "  ✓ 解压完成: $1"
}

# 同时更新 brew 和 zinit
function update-all() {
  brew-update
  zinit-update
  lark-cli update
  atuin sync
  brew bundle dump --file="$HOME/.config/Brewfile" --force --quiet
}

# chezmoi-push [-n] [file ...]
#   -n          dry-run：只显示变更，不提交不推送
#   无参数      仅 commit + push（适合已手动 re-add 完毕的情况）
#   带文件路径  先 chezmoi re-add 各文件，再 commit + push
function chezmoi-push() {
  local chezmoi_src="$HOME/.local/share/chezmoi"
  local dry_run=0
  local failed=()
  local re_added=()

  # 解析 -n
  if [[ $1 == "-n" ]]; then
    dry_run=1
    shift
  fi

  # re-add 指定文件
  for f in "$@"; do
    local abs="${f:A}"   # zsh 内置：展开 ~ 并解析相对路径为绝对路径
    if chezmoi re-add "$abs" 2>/dev/null; then
      re_added+=("$abs")
    else
      failed+=("$abs")
    fi
  done

  [[ ${#failed[@]} -gt 0 ]] && print -P "%F{red}re-add failed:%f ${(j:, :)failed}"

  # 检查是否有变更
  local git_status
  git_status=$(git -C "$chezmoi_src" status --short)
  if [[ -z $git_status ]]; then
    echo "nothing to commit"
    return 0
  fi

  # 显示变更摘要
  git -C "$chezmoi_src" diff --stat HEAD 2>/dev/null || git -C "$chezmoi_src" status --short

  [[ $dry_run -eq 1 ]] && return 0

  # 自动生成 commit message
  local msg
  if [[ ${#re_added[@]} -gt 0 ]]; then
    local names=("${(@f)$(printf '%s\n' "${re_added[@]}" | xargs -I{} basename {})}")
    msg="chore: update ${(j:, :)names}"
  else
    local changed=("${(@f)$(git -C "$chezmoi_src" status --short | awk '{print $2}' | xargs -I{} basename {})}")
    msg="chore: update ${(j:, :)changed}"
  fi

  git -C "$chezmoi_src" add -A
  git -C "$chezmoi_src" commit -m "$msg"
  git -C "$chezmoi_src" push
}

