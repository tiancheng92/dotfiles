# XDG Base Directory
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# 始终使用 chezmoi 管理的 Atuin 配置，不受旧 ~/.atuin/config.toml 遮蔽。
export ATUIN_CONFIG_DIR="$XDG_CONFIG_HOME/atuin"

# npm
export npm_config_cache="$XDG_CACHE_HOME/npm"

# 编辑器
export EDITOR="code --wait"
export VISUAL="code --wait"

# man 页用 bat 渲染
export MANPAGER="sh -c 'col -bx | bat -l man --paging=never --style=plain'"

# less
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export LESS='-RFX --use-color -Dd+r -Du+b'

# ripgrep
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/rc"

# PATH：所有 shell 可用；登录时在 path_helper/Homebrew 之后重新恢复优先级
typeset -gU path PATH
typeset -ga _zsh_preferred_path
_zsh_preferred_path=(
  "$HOME/.dbx/bin"
  "$HOME/.local/bin"
  "${GOPATH:-$HOME/go}/bin"
  /opt/homebrew/opt/curl/bin
  /opt/homebrew/opt/rustup/bin
)
if [[ -x /Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex ]]; then
  _zsh_preferred_path=(/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS "${_zsh_preferred_path[@]}")
fi
path=("${_zsh_preferred_path[@]}" /opt/homebrew/bin /opt/homebrew/sbin "${path[@]}")
export PATH

# Homebrew
export HOMEBREW_CURL_PATH="/opt/homebrew/opt/curl/bin/curl"
export HOMEBREW_NO_INSTALL_CLEANUP=1   # 不自动清理旧版本，手动 brew cleanup 更可控
export HOMEBREW_NO_ASK=1              # 安装/升级时不询问确认（[y/n]）
export HOMEBREW_NO_AUTO_UPDATE=1       # 安装包时不强制更新 Homebrew 本身
export HOMEBREW_NO_ANALYTICS=1         # 关闭匿名统计上报
export HOMEBREW_NO_ENV_HINTS=1         # 不显示 cask 升级提示等冗余信息
export HOMEBREW_UPGRADE_GREEDY=1       # upgrade 时一并升级 auto_update 的 cask
export HOMEBREW_CLEANUP_MAX_AGE_DAYS=1 # cleanup 只保留 1 天内的旧版本
export HOMEBREW_NO_BOOTSNAP=1          # 禁用 Bootsnap 缓存，避免偶发缓存问题
